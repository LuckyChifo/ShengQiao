<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShengQiao" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/sq_background</item>
        <item name="android:statusBarColor">@color/sq_background</item>
        <item name="android:navigationBarColor">@color/sq_surface</item>
        <item name="colorPrimary">@color/sq_primary</item>
        <item name="colorOnPrimary">@color/sq_on_primary</item>
        <item name="colorSurface">@color/sq_surface</item>
        <item name="colorOnSurface">@color/sq_text</item>
        <item name="colorSurfaceVariant">@color/sq_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/sq_text_secondary</item>
        <item name="colorError">@color/sq_error</item>
        <item name="colorControlActivated">@color/sq_primary</item>
        <item name="materialButtonStyle">@style/Widget.ShengQiao.Button</item>
        <item name="seekBarStyle">@style/Widget.ShengQiao.SeekBar</item>
        <item name="android:seekBarStyle">@style/Widget.ShengQiao.SeekBar</item>
    </style>

    <style name="TextAppearance.ShengQiao.PageTitle" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/sq_text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.ShengQiao.PanelTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/sq_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.ShengQiao.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/sq_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.ShengQiao.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/sq_text</item>
    </style>

    <style name="Widget.ShengQiao.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.ShengQiao.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeColor">@color/sq_control_stroke</item>
        <item name="backgroundTint">@color/sq_surface</item>
    </style>

    <style name="Widget.ShengQiao.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <style name="Widget.ShengQiao.Button.Choice" parent="Widget.ShengQiao.Button.Outlined">
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textColor">@color/sq_choice_text</item>
        <item name="icon">@drawable/sq_chevron_down</item>
        <item name="iconGravity">end</item>
        <item name="iconTint">@color/sq_choice_text</item>
        <item name="iconSize">20dp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.ShengQiao.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="android:textColor">@color/sq_choice_text</item>
        <item name="thumbTint">@color/sq_switch_thumb</item>
        <item name="trackTint">@color/sq_switch_track</item>
        <item name="useMaterialThemeColors">false</item>
    </style>

    <style name="Widget.ShengQiao.SeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressTint">@color/sq_primary</item>
        <item name="android:thumbTint">@color/sq_primary</item>
        <item name="android:progressBackgroundTint">@color/sq_surface_variant</item>
    </style>

    <style name="Widget.ShengQiao.Input" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/sq_surface</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <style name="ThemeOverlay.ShengQiao.Input" parent="">
        <item name="textInputStyle">@style/Widget.ShengQiao.Input</item>
    </style>

    <style name="Widget.ShengQiao.BottomNavigationView.ActiveIndicator"
        parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="Widget.ShengQiao.InfoButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:src">@drawable/sq_info</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="Widget.ShengQiao.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/sq_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
