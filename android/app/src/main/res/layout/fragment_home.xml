<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="104dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/page_title"
            android:text="@string/nav_home"
            android:textAppearance="@style/TextAppearance.ShengQiao.PageTitle" />

        <com.shengqiao.app.ui.glass.GlassLayout
            android:id="@+id/connection_glass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connection_button"
                style="@style/Widget.ShengQiao.Button.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start|center_vertical"
                android:minHeight="52dp"
                android:text="@string/home_connection_hint"
                android:textAlignment="viewStart"
                android:textColor="@color/sq_text"
                app:icon="@drawable/sq_chevron_right"
                app:iconGravity="end"
                app:iconSize="20dp" />
        </com.shengqiao.app.ui.glass.GlassLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_listen"
                android:textColor="@color/sq_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/listen_info"
                style="@style/Widget.ShengQiao.InfoButton"
                android:contentDescription="@string/info_show_description" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/listen_switch"
                style="@style/Widget.ShengQiao.Switch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:contentDescription="@string/home_listen" />
        </LinearLayout>

        <TextView
            android:id="@+id/listen_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_listen_off"
            android:textColor="@color/sq_text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="@color/sq_surface_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_microphone"
                android:textColor="@color/sq_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/microphone_info"
                style="@style/Widget.ShengQiao.InfoButton"
                android:contentDescription="@string/info_show_description" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/microphone_switch"
                style="@style/Widget.ShengQiao.Switch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:contentDescription="@string/home_microphone" />
        </LinearLayout>

        <TextView
            android:id="@+id/microphone_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_microphone_off"
            android:textColor="@color/sq_text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="@color/sq_surface_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/volume_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_volume"
                android:textColor="@color/sq_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/volume_info"
                style="@style/Widget.ShengQiao.InfoButton"
                android:contentDescription="@string/info_show_description" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/volume_edit_button"
                style="@style/Widget.ShengQiao.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minHeight="40dp"
                android:text="@string/home_volume_edit" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/volume_seek"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:contentDescription="@string/home_volume"
            android:max="200"
            android:progress="100" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="4dp"
            android:background="@color/sq_surface_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_level_title"
                android:textColor="@color/sq_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/level_info"
                style="@style/Widget.ShengQiao.InfoButton"
                android:contentDescription="@string/info_show_description" />
        </LinearLayout>

        <TextView
            android:id="@+id/level_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_level_unavailable"
            android:textColor="@color/sq_text_secondary"
            android:textSize="13sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:background="@color/sq_surface_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_diagnostics_title"
                android:textColor="@color/sq_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/connection_info"
                style="@style/Widget.ShengQiao.InfoButton"
                android:contentDescription="@string/info_show_description" />
        </LinearLayout>

        <TextView
            android:id="@+id/connection_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="2"
            android:text="@string/home_not_connected"
            android:textColor="@color/sq_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/details_button"
                style="@style/Widget.ShengQiao.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_details" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnect_button"
                style="@style/Widget.ShengQiao.Button.Text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/home_disconnect"
                android:textColor="@color/sq_error" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
